{
  "name": "@onlypain/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "pretest": "node scripts/test-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@prisma/client": "6.19.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "3.0.3",
    "hono": "4.13.8",
    "ioredis": "5.11.1",
    "jose": "6.2.12",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "resend": "6.28.1",
    "socket.io": "4.8.3",
    "stripe": "22.6.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "pino-pretty": "13.1.3",
    "prisma": "6.19.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}

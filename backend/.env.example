# ---- Required ----
DATABASE_URL="mongodb://127.0.0.1:27018/onlypain?replicaSet=rs0"
JWT_SECRET="change-me-64-hex-chars"
JWT_REFRESH_SECRET="change-me-64-hex-chars"
CLIENT_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# ---- AI (Claude). Leave empty to run with the built-in mock provider ----
ANTHROPIC_API_KEY=""
AI_MODEL_COMPANION="claude-opus-5"
AI_MODEL_CLASSIFIER="claude-haiku-4-5"
AI_SAFETY_MODE="full"   # full | keywords | off

# ---- Optional infrastructure ----
REDIS_URL=""            # e.g. rediss://default:***@fly-xyz.upstash.io:6379 (rate limits + socket adapter)
RESEND_API_KEY=""       # transactional email; logs to console when empty
EMAIL_FROM="only pain <hello@onlypain.app>"

# ---- Billing (Stripe). Leave empty to hide upgrade flows ----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PLUS_MONTHLY=""

# ---- Admin bootstrap: comma-separated emails that become ADMIN on signup ----
ADMIN_EMAILS=""
